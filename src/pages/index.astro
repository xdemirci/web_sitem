---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <h1 class="hero-title">Hoşgeldin!</h1>
        <p class="hero-subtitle">
          Başımla beraber, keşfetmeye hazır mısına?
        </p>
        <div class="hero-links">
          <a href="/blog" class="hero-btn">Yazılar</a>
          <a href="/projects" class="hero-btn">Projeler</a>
          <a href="/corner" class="hero-btn">Köşe</a>
        </div>
      </section>

      <style>
        main {
          position: relative;
          overflow: hidden;
          min-height: 60vh;
          display: flex;
          align-items: center;
        }

        .hero {
          width: 100%;
          text-align: center;
        }

        .hero-title {
          font-size: 3rem;
          margin: 0 0 0.5rem;
          opacity: 0;
          transform: translateY(20px);
          animation: fadeSlideUp 0.7s ease-out forwards;
        }

        .hero-subtitle {
          font-size: 1.25rem;
          color: rgb(var(--gray));
          margin: 0 0 2rem;
          opacity: 0;
          transform: translateY(20px);
          animation: fadeSlideUp 0.7s ease-out 0.15s forwards;
        }

        .hero-links {
          display: flex;
          gap: 1rem;
          justify-content: center;
          flex-wrap: wrap;
          opacity: 0;
          transform: translateY(20px);
          animation: fadeSlideUp 0.7s ease-out 0.3s forwards;
        }

        .hero-btn {
          display: inline-block;
          padding: 0.75rem 1.5rem;
          border-radius: 999px;
          background: var(--accent);
          color: white;
          text-decoration: none;
          font-weight: 600;
          transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .hero-btn:hover {
          transform: translateY(-3px) scale(1.05);
          box-shadow: var(--box-shadow);
        }

        @keyframes fadeSlideUp {
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        @media (max-width: 720px) {
          .hero-title {
            font-size: 2rem;
          }
        }

        @media (prefers-reduced-motion: reduce) {
          .hero-title,
          .hero-subtitle,
          .hero-links {
            animation: none;
            opacity: 1;
            transform: none;
          }
        }
      </style>
    </main>
    <Footer />
  </body>
</html>