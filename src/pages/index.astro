---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <h1 class="hero-title">Merhaba, ben Ömer</h1>
        <p class="hero-subtitle">
          Bilgisayar mühendisliği mezunuyum. Gömülü ve otonom sistemler, simülasyon, 
          insansız hava araçları ve sürü iha 
          üzerine çalışıyorum: ArduPilot SITL, Gazebo, pymavlink, OpenCV, ROS2.
        </p>
        <div class="hero-links">
          <a href="/blog" class="hero-btn">Yazılar</a>
          <a href="/projects" class="hero-btn">Projeler</a>
          <a href="/corner" class="hero-btn">Köşe</a>
        </div>
      </section>

      <section class="trailers">
        <a href="/projects" class="trailer-card" style="background-image: url('/images/projects-trailer.jpg');">
          <div class="trailer-overlay">
            <h3>Projeler</h3>
            <p>Gazebo, YOLOv8n, ArUco ve daha fazlası</p>
          </div>
        </a>
        <a href="/corner" class="trailer-card" style="background-image: url('/images/corner-trailer.jpg');">
          <div class="trailer-overlay">
            <h3>Köşe</h3>
            <p>Kabadayılık, sözler, video</p>
          </div>
        </a>
      </section>

      <style>
        main {
          position: relative;
          overflow: hidden;
        }

        .hero {
          width: 100%;
          text-align: center;
          padding: 4rem 0 2rem;
        }

        .hero-title {
          font-size: 3rem;
          margin: 0 0 0.5rem;
          opacity: 0;
          transform: translateY(20px);
          animation: fadeSlideUp 0.7s ease-out forwards;
        }

        .hero-subtitle {
          font-size: 1.25rem;
          color: rgb(var(--gray));
          margin: 0 0 2rem;
          opacity: 0;
          transform: translateY(20px);
          animation: fadeSlideUp 0.7s ease-out 0.15s forwards;
        }

        .hero-links {
          display: flex;
          gap: 1rem;
          justify-content: center;
          flex-wrap: wrap;
          opacity: 0;
          transform: translateY(20px);
          animation: fadeSlideUp 0.7s ease-out 0.3s forwards;
        }

        .hero-btn {
          display: inline-block;
          padding: 0.75rem 1.5rem;
          border-radius: 999px;
          background: var(--accent);
          color: white;
          text-decoration: none;
          font-weight: 600;
          transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .hero-btn:hover {
          transform: translateY(-3px) scale(1.05);
          box-shadow: var(--box-shadow);
        }

        @keyframes fadeSlideUp {
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        .trailers {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 1.5rem;
          margin: 2rem 0 4rem;
        }

        .trailer-card {
          position: relative;
          display: block;
          height: 280px;
          border-radius: 16px;
          background-size: cover;
          background-position: center;
          background-color: rgb(var(--gray-light));
          overflow: hidden;
          text-decoration: none;
          box-shadow: var(--box-shadow);
          transition: transform 0.25s ease;
        }

        .trailer-card:hover {
          transform: scale(1.02);
        }

        .trailer-overlay {
          position: absolute;
          inset: 0;
          display: flex;
          flex-direction: column;
          justify-content: flex-end;
          padding: 1.25rem;
          background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent 60%);
          color: white;
        }

        .trailer-overlay h3 {
          margin: 0 0 0.25rem;
          color: white;
          font-size: 1.5rem;
        }

        .trailer-overlay p {
          margin: 0;
          font-size: 0.95rem;
          opacity: 0.9;
        }

        @media (max-width: 720px) {
          .hero-title {
            font-size: 2rem;
          }
          .trailers {
            grid-template-columns: 1fr;
          }
        }

        @media (prefers-reduced-motion: reduce) {
          .hero-title,
          .hero-subtitle,
          .hero-links {
            animation: none;
            opacity: 1;
            transform: none;
          }
        }
      </style>
    </main>
    <Footer />
  </body>
</html>