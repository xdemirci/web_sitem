---
import Layout from '../../layouts/BlogPost.astro';

const projects = [
  {
    slug: 'mobil-uygulama',
    title: 'Mobil Uygulama',
    category: 'Flutter / .NET',
    image: 'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?auto=format&fit=crop&w=1200&q=80',
    excerpt: 'Mobil kullanıcı deneyimi odaklı, hızlı ve güvenli bir uygulama geliştirme süreci.',
    tags: ['Flutter', 'REST API', 'UI/UX']
  },
  {
    slug: 'web-platformu',
    title: 'Web Platformu',
    category: 'Astro / TypeScript',
    image: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=80',
    excerpt: 'İşletme içi operasyonları kolaylaştıran modern ve ölçeklenebilir web çözümü.',
    tags: ['Astro', 'TypeScript', 'Dashboard']
  },
  {
    slug: 'otomasyon-sistemi',
    title: 'Otomasyon Sistemi',
    category: 'Python / API',
    image: 'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80',
    excerpt: 'Zaman tasarrufu sağlayan otomatik iş akışları ve raporlama altyapısı.',
    tags: ['Python', 'API', 'Automation']
  },
  {
    slug: 'veri-analizi',
    title: 'Veri Analizi',
    category: 'Data / Dashboard',
    image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80',
    excerpt: 'Veri görselleştirme ve karar destek sistemleri için hazırlanan analitik çalışma.',
    tags: ['Analytics', 'Charts', 'Insights']
  }
];
---

<Layout
  title="Projelerim"
  description="Yaptığım projeler ve geliştirdiğim çözümler"
  pubDate={new Date('August 08 2021')}
>
  <div class="blog-grid">
    {projects.map((project) => (
      <a href={`/projeler/${project.slug}`} class="blog-card">
        <div class="card-image-wrap">
          <img src={project.image} alt={project.title} class="card-image" />
        </div>

        <div class="card-content">
          <div class="meta-row">
            <span class="category">{project.category}</span>
            <span class="dot">•</span>
            <span class="read-time">5 min</span>
          </div>

          <h2>{project.title}</h2>
          <p>{project.excerpt}</p>

          <div class="tag-row">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 0 4rem;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: rgba(17, 24, 39, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .blog-card:hover {
    transform: translateY(-3px);
    border-color: rgba(167, 139, 250, 0.45);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
  }

  .card-image-wrap {
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #0f172a;
  }

  .card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    padding: 1.2rem 1.2rem 1.4rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: #c4b5fd;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.8rem;
  }

  .dot {
    opacity: 0.75;
  }

  .card-content h2 {
    margin: 0 0 0.7rem;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    line-height: 1.2;
    color: #f8fafc;
  }

  .card-content p {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.7;
    font-size: 0.96rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgba(167, 139, 250, 0.12);
    border: 1px solid rgba(167, 139, 250, 0.18);
    color: #ddd6fe;
    font-size: 0.72rem;
  }

  @media (max-width: 820px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>